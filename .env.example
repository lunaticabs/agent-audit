# DeepSeek Harness / DeepSeek official API
DEEPSEEK_API_KEY=
DSH_MODEL=deepseek-flash
DSH_REASONING_EFFORT=max

# On-chain data sources. The agent calls these directly; there is no CLI wrapper.
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
# Also used by run_persist to fill runs_meta.block_number when the run saved none.
RPC_URL=

# Optional: copy each finished run here in addition to the working runs/ root.
# AGENT_AUDIT_PERSIST_DIR=

# Pull mode (k3s / KEDA). When no prompt is given and this URL is set, the
# container claims one task from the Redis Stream instead of reading FULL_PROMPT.
# Leave it unset for single-audit Docker runs.
# AGENT_AUDIT_REDIS_URL=redis://agent-audit-redis:6379/0
# AGENT_AUDIT_QUEUE_GROUP=agent-audit-runners
# AGENT_AUDIT_QUEUE_STREAM=agent-audit:tasks
# Per-attempt budget in seconds; the k3s ScaledJob sets 3000.
# AGENT_AUDIT_MAX_DURATION_SECONDS=

# MongoDB archive. When AGENT_AUDIT_MONGO_URI is set, the entrypoint writes one
# runs_meta document plus that run's own runs_files material after every audit.
# Leave it unset for local-only runs. Set AGENT_AUDIT_MONGO_PERSIST=0 to disable.
# AGENT_AUDIT_MONGO_URI=mongodb://user:password@host:27017/?authSource=admin
# AGENT_AUDIT_MONGO_DB=agent
# AGENT_AUDIT_MONGO_RUNS_META_COLLECTION=runs_meta
# AGENT_AUDIT_MONGO_RUNS_FILES_COLLECTION=runs_files
# AGENT_AUDIT_MONGO_MAX_INLINE_FILE_BYTES=8388608

# Legacy names are still accepted as fallbacks:
#   AGENT_AUDIT_SOURCE_API_KEY, AGENT_AUDIT_SOURCE_API_BASE, AGENT_AUDIT_RPC_URL
